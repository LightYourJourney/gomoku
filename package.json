{
  "name": "gomoku-lab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b && tsc -p tsconfig.e2e.json && tsc -p tsconfig.bench.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:prod": "playwright test --config playwright.prod.config.ts",
    "e2e:remote": "playwright test --config playwright.remote.config.ts",
    "lint": "oxlint",
    "bench": "vitest run --config vitest.bench.config.ts",
    "bench:render": "yarn build && node bench/render.probe.mjs",
    "bench:learn": "vitest run --config vitest.learn.config.ts",
    "bench:blocking": "node bench/blocking.probe.mjs",
    "profile": "vitest run --config vitest.profile.config.ts",
    "strength": "vitest run --config vitest.strength.config.ts",
    "strength:bundle": "node bench/strength/bundle-engine.mjs",
    "ui:probe": "node bench/ui.probe.mjs",
    "check:cycles": "madge --circular --extensions ts,tsx src",
    "check:deadcode": "knip --reporter compact",
    "check:dupes": "jscpd --config .jscpd.json",
    "bench:check": "yarn bench && node bench/gate.mjs",
    "gates": "yarn check:cycles && yarn check:deadcode && yarn check:dupes && yarn check:tests",
    "prepare": "git config core.hooksPath .githooks",
    "check:coverage": "node quality/coverage.ratchet.mjs",
    "check:tests": "node quality/tests.ratchet.mjs"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "fake-indexeddb": "^6.2.5",
    "jscpd": "5.4.1",
    "jsdom": "^30.1.2",
    "knip": "6.41.0",
    "madge": "8.0.0",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.3"
  }
}
